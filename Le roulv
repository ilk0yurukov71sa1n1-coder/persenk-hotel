<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Le Roulv — Ghost</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel+Decorative:wght@400;700&family=Raleway:wght@100;200;300;400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --cream: #f5f0e8;
      --ivory: #fdfaf4;
      --gold: #c9a84c;
      --gold-light: #e8d5a3;
      --navy: #0d1b2a;
      --navy-mid: #162336;
      --ink: #1a1a2e;
      --ghost: rgba(255,255,255,0.06);
      --glass: rgba(255,255,255,0.12);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      background: #050a12;
      color: var(--cream);
      font-family: 'Raleway', sans-serif;
      font-weight: 200;
      overflow-x: hidden;
      cursor: none;
    }

    /* ─── CURSOR ─── */
    #cursor {
      position: fixed;
      width: 12px; height: 12px;
      background: var(--gold);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%,-50%);
      transition: transform 0.1s, opacity 0.2s;
      mix-blend-mode: screen;
    }
    #cursor-ring {
      position: fixed;
      width: 36px; height: 36px;
      border: 1px solid rgba(201,168,76,0.4);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%,-50%);
      transition: all 0.18s ease;
    }

    /* ─── CANVAS ─── */
    #bg-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    /* ─── LANGUAGE SWITCHER ─── */
    #lang-switcher {
      position: fixed;
      top: 28px; right: 36px;
      z-index: 100;
      display: flex;
      gap: 14px;
    }
    #lang-switcher button {
      background: none;
      border: none;
      color: rgba(245,240,232,0.45);
      font-family: 'Raleway', sans-serif;
      font-weight: 300;
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      cursor: pointer;
      transition: color 0.3s;
      padding: 0;
    }
    #lang-switcher button.active,
    #lang-switcher button:hover { color: var(--gold); }

    /* ─── NAV ─── */
    nav {
      position: fixed;
      top: 0; left: 0;
      width: 100%;
      z-index: 90;
      padding: 26px 44px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(180deg, rgba(5,10,18,0.9) 0%, transparent 100%);
    }
    .nav-logo {
      font-family: 'Cinzel Decorative', serif;
      font-size: 15px;
      letter-spacing: 0.22em;
      color: var(--cream);
      text-decoration: none;
      font-weight: 400;
    }
    .nav-links {
      display: flex;
      gap: 38px;
      list-style: none;
    }
    .nav-links a {
      color: rgba(245,240,232,0.55);
      text-decoration: none;
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      font-weight: 300;
      transition: color 0.3s;
    }
    .nav-links a:hover { color: var(--gold); }

    /* ─── SECTIONS ─── */
    section { position: relative; z-index: 1; }

    /* ─── HERO ─── */
    #hero {
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 24px;
      overflow: hidden;
    }

    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: 0.38em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 38px;
      opacity: 0;
      animation: fadeUp 1.2s 0.4s forwards;
    }

    .logo-container {
      position: relative;
      display: inline-block;
      margin-bottom: 44px;
      opacity: 0;
      animation: fadeIn 1.8s 0.8s forwards;
    }

    .logo-svg {
      width: 220px;
      height: 220px;
      filter: drop-shadow(0 0 30px rgba(201,168,76,0.3));
    }

    .hero-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(38px, 7vw, 88px);
      font-weight: 400;
      letter-spacing: 0.14em;
      color: var(--ivory);
      line-height: 1.1;
      opacity: 0;
      animation: fadeUp 1.2s 1.1s forwards;
    }
    .hero-title span { color: var(--gold); }

    .hero-sub {
      margin-top: 22px;
      font-size: 13px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: rgba(245,240,232,0.5);
      opacity: 0;
      animation: fadeUp 1.2s 1.4s forwards;
    }

    .hero-scroll {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      color: rgba(201,168,76,0.5);
      font-size: 9px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      animation: pulse 2.4s infinite;
    }
    .scroll-line {
      width: 1px;
      height: 54px;
      background: linear-gradient(180deg, var(--gold), transparent);
    }

    /* ─── MANIFESTO ─── */
    #manifesto {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 120px 44px;
    }

    .manifesto-inner {
      max-width: 820px;
      margin: 0 auto;
    }
    .section-label {
      font-size: 9px;
      letter-spacing: 0.5em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 52px;
      display: flex;
      align-items: center;
      gap: 18px;
    }
    .section-label::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--gold), transparent);
      max-width: 120px;
    }

    .manifesto-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(22px, 3.5vw, 36px);
      line-height: 1.65;
      font-weight: 300;
      font-style: italic;
      color: var(--cream);
    }
    .manifesto-text em {
      font-style: normal;
      color: var(--gold);
    }

    .manifesto-signature {
      margin-top: 60px;
      display: flex;
      align-items: center;
      gap: 24px;
    }
    .signature-line { width: 60px; height: 1px; background: var(--gold); opacity: 0.5; }
    .signature-text {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 15px;
      color: rgba(201,168,76,0.7);
    }

    /* ─── ABOUT ─── */
    #about {
      padding: 120px 44px;
      max-width: 1100px;
      margin: 0 auto;
    }
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: start;
    }
    .about-left h2 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(28px, 4vw, 52px);
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 36px;
      color: var(--cream);
    }
    .about-left h2 span { color: var(--gold); }
    .about-body {
      font-family: 'Cormorant Garamond', serif;
      font-size: 18px;
      line-height: 1.85;
      color: rgba(245,240,232,0.8);
    }
    .about-right {
      padding-top: 60px;
    }
    .about-stat {
      border-top: 1px solid rgba(201,168,76,0.2);
      padding: 28px 0;
    }
    .about-stat:last-child { border-bottom: 1px solid rgba(201,168,76,0.2); }
    .stat-number {
      font-family: 'Cinzel Decorative', serif;
      font-size: 38px;
      color: var(--gold);
      margin-bottom: 6px;
    }
    .stat-label {
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: rgba(245,240,232,0.4);
    }

    /* ─── FABRICS ─── */
    #fabrics {
      padding: 120px 44px;
      background: linear-gradient(180deg, transparent 0%, rgba(201,168,76,0.04) 50%, transparent 100%);
    }
    .fabrics-header {
      text-align: center;
      margin-bottom: 90px;
    }
    .fabrics-header h2 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(28px, 4vw, 48px);
      font-weight: 400;
      color: var(--cream);
      margin-bottom: 18px;
    }
    .fabrics-header p {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 18px;
      color: rgba(245,240,232,0.5);
    }

    .fabrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2px;
      max-width: 1000px;
      margin: 0 auto;
    }
    .fabric-card {
      position: relative;
      padding: 52px 40px;
      background: var(--ghost);
      border: 1px solid rgba(201,168,76,0.08);
      backdrop-filter: blur(12px);
      overflow: hidden;
      transition: all 0.5s ease;
      cursor: pointer;
    }
    .fabric-card:hover {
      background: rgba(201,168,76,0.06);
      border-color: rgba(201,168,76,0.25);
      transform: translateY(-4px);
    }
    .fabric-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
      transform: scaleX(0);
      transition: transform 0.5s;
    }
    .fabric-card:hover::before { transform: scaleX(1); }

    .fabric-icon {
      font-size: 42px;
      margin-bottom: 24px;
      opacity: 0.75;
    }
    .fabric-name {
      font-family: 'Cinzel Decorative', serif;
      font-size: 18px;
      color: var(--gold);
      margin-bottom: 10px;
      font-weight: 400;
    }
    .fabric-origin {
      font-size: 9px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: rgba(201,168,76,0.5);
      margin-bottom: 20px;
    }
    .fabric-desc {
      font-family: 'Cormorant Garamond', serif;
      font-size: 16px;
      line-height: 1.75;
      color: rgba(245,240,232,0.7);
    }
    .fabric-props {
      margin-top: 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .prop-tag {
      font-size: 8px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      padding: 5px 12px;
      border: 1px solid rgba(201,168,76,0.25);
      color: rgba(201,168,76,0.7);
    }

    /* ─── PHILOSOPHY ─── */
    #philosophy {
      padding: 140px 44px;
      text-align: center;
      max-width: 900px;
      margin: 0 auto;
    }
    #philosophy h2 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(26px, 4vw, 46px);
      color: var(--cream);
      margin-bottom: 70px;
      font-weight: 400;
    }
    .pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
      margin-bottom: 80px;
    }
    .pillar {
      text-align: left;
      padding: 36px 28px;
      border-left: 1px solid rgba(201,168,76,0.2);
      transition: border-color 0.4s;
    }
    .pillar:hover { border-left-color: var(--gold); }
    .pillar-num {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 48px;
      color: rgba(201,168,76,0.2);
      line-height: 1;
      margin-bottom: 16px;
    }
    .pillar-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: 13px;
      color: var(--gold);
      margin-bottom: 14px;
      font-weight: 400;
    }
    .pillar-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 15px;
      line-height: 1.8;
      color: rgba(245,240,232,0.65);
    }

    .philosophy-quote {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: clamp(20px, 3vw, 30px);
      color: rgba(245,240,232,0.55);
      line-height: 1.7;
      padding: 40px;
      border: 1px solid rgba(201,168,76,0.12);
      position: relative;
    }
    .philosophy-quote::before {
      content: '"';
      position: absolute;
      top: -20px; left: 30px;
      font-size: 80px;
      color: var(--gold);
      opacity: 0.3;
      line-height: 1;
    }

    /* ─── FEATURES ─── */
    #features {
      padding: 120px 44px;
      max-width: 1100px;
      margin: 0 auto;
    }
    .features-header { margin-bottom: 80px; }
    .features-header h2 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(28px, 4vw, 48px);
      color: var(--cream);
      font-weight: 400;
    }
    .features-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: rgba(201,168,76,0.08);
    }
    .feature-item {
      background: #050a12;
      padding: 48px 44px;
      display: flex;
      gap: 28px;
      align-items: flex-start;
      transition: background 0.4s;
      position: relative;
      overflow: hidden;
    }
    .feature-item:hover { background: rgba(201,168,76,0.04); }
    .feature-icon-wrap {
      width: 50px; height: 50px;
      border: 1px solid rgba(201,168,76,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 20px;
      color: var(--gold);
    }
    .feature-content h3 {
      font-family: 'Cinzel Decorative', serif;
      font-size: 14px;
      color: var(--gold);
      margin-bottom: 10px;
      font-weight: 400;
    }
    .feature-content p {
      font-family: 'Cormorant Garamond', serif;
      font-size: 16px;
      line-height: 1.7;
      color: rgba(245,240,232,0.6);
    }

    /* ─── CONTACT / WAITLIST ─── */
    #contact {
      padding: 160px 44px;
      text-align: center;
      background: linear-gradient(180deg, transparent, rgba(201,168,76,0.04) 50%, transparent);
    }
    #contact h2 {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(28px, 4.5vw, 56px);
      color: var(--cream);
      margin-bottom: 20px;
      font-weight: 400;
    }
    #contact .sub {
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 20px;
      color: rgba(245,240,232,0.5);
      margin-bottom: 60px;
    }
    .email-form {
      display: flex;
      max-width: 480px;
      margin: 0 auto 40px;
      gap: 0;
    }
    .email-form input {
      flex: 1;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(201,168,76,0.25);
      border-right: none;
      color: var(--cream);
      padding: 16px 22px;
      font-family: 'Raleway', sans-serif;
      font-size: 13px;
      letter-spacing: 0.1em;
      outline: none;
    }
    .email-form input::placeholder { color: rgba(245,240,232,0.25); }
    .email-form input:focus { border-color: rgba(201,168,76,0.6); }
    .email-form button {
      background: var(--gold);
      border: none;
      color: #050a12;
      padding: 16px 28px;
      font-family: 'Raleway', sans-serif;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.3s;
    }
    .email-form button:hover { background: var(--gold-light); }

    .contact-socials {
      display: flex;
      justify-content: center;
      gap: 32px;
      margin-top: 60px;
    }
    .social-link {
      color: rgba(245,240,232,0.35);
      text-decoration: none;
      font-size: 10px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      transition: color 0.3s;
      position: relative;
    }
    .social-link::after {
      content: '';
      position: absolute;
      bottom: -4px; left: 0;
      width: 0; height: 1px;
      background: var(--gold);
      transition: width 0.3s;
    }
    .social-link:hover { color: var(--gold); }
    .social-link:hover::after { width: 100%; }

    /* ─── FOOTER ─── */
    footer {
      padding: 40px 44px;
      border-top: 1px solid rgba(201,168,76,0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .footer-brand {
      font-family: 'Cinzel Decorative', serif;
      font-size: 13px;
      color: rgba(245,240,232,0.35);
    }
    .footer-text {
      font-size: 10px;
      letter-spacing: 0.2em;
      color: rgba(245,240,232,0.2);
    }

    /* ─── SCROLL REVEALS ─── */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ─── KEYFRAMES ─── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes pulse {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.9; }
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 768px) {
      nav { padding: 20px 22px; }
      .nav-links { display: none; }
      .about-grid { grid-template-columns: 1fr; gap: 50px; }
      .pillars { grid-template-columns: 1fr; gap: 24px; }
      .features-list { grid-template-columns: 1fr; }
      footer { flex-direction: column; gap: 14px; text-align: center; }
      .email-form { flex-direction: column; }
      .email-form input { border-right: 1px solid rgba(201,168,76,0.25); border-bottom: none; }
      #lang-switcher { top: 20px; right: 20px; }
    }
  </style>
</head>
<body>

<!-- Cursor -->
<div id="cursor"></div>
<div id="cursor-ring"></div>

<!-- Background Canvas -->
<canvas id="bg-canvas"></canvas>

<!-- Language Switcher -->
<div id="lang-switcher">
  <button class="active" onclick="setLang('en')">EN</button>
  <button onclick="setLang('fr')">FR</button>
  <button onclick="setLang('bg')">БГ</button>
</div>

<!-- Navigation -->
<nav>
  <a class="nav-logo" href="#">Le Roulv</a>
  <ul class="nav-links">
    <li><a href="#manifesto" data-i18n="nav_manifesto">Manifesto</a></li>
    <li><a href="#about" data-i18n="nav_about">About</a></li>
    <li><a href="#fabrics" data-i18n="nav_fabrics">Fabrics</a></li>
    <li><a href="#philosophy" data-i18n="nav_philosophy">Philosophy</a></li>
    <li><a href="#contact" data-i18n="nav_contact">Contact</a></li>
  </ul>
</nav>

<!-- ══ HERO ══ -->
<section id="hero">
  <p class="hero-eyebrow" data-i18n="hero_eyebrow">Luxury · Faith · Imperfection</p>

  <div class="logo-container">
    <svg class="logo-svg" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Hand-drawn figure reconstructed from sketch: human form + R letterform + cross crown -->
      <g stroke="#c9a84c" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <!-- Cross / Crown at top -->
        <line x1="110" y1="22" x2="110" y2="38" stroke-width="1.8"/>
        <line x1="103" y1="29" x2="117" y2="29" stroke-width="1.4"/>
        <!-- Head -->
        <circle cx="110" cy="46" r="5" stroke-width="1.4"/>
        <!-- Torso / spine -->
        <line x1="110" y1="51" x2="110" y2="110" stroke-width="1.8"/>
        <!-- Left arm -->
        <path d="M110 68 Q95 72 88 82" stroke-width="1.5"/>
        <!-- Right arm curved outward — forming the R arc -->
        <path d="M110 60 Q134 56 138 72 Q140 84 122 90" stroke-width="1.8"/>
        <!-- R leg diagonal (lower bowl) -->
        <path d="M116 90 Q132 108 140 126" stroke-width="1.8"/>
        <!-- Left leg -->
        <path d="M110 110 Q102 130 96 150" stroke-width="1.8"/>
        <!-- Right leg -->
        <path d="M110 110 Q118 132 126 148" stroke-width="1.8"/>
        <!-- Left foot curl -->
        <path d="M96 150 Q92 156 98 158" stroke-width="1.3"/>
        <!-- Right foot -->
        <path d="M126 148 Q130 154 136 152" stroke-width="1.3"/>
        <!-- Flowing cape/movement line top right -->
        <path d="M132 58 Q152 46 162 62 Q168 72 158 80" stroke-width="1.3" stroke-dasharray="3 2"/>
        <!-- Subtle ground mark -->
        <line x1="88" y1="165" x2="142" y2="165" stroke-width="0.8" opacity="0.3"/>
      </g>
      <!-- Subtle glow -->
      <circle cx="110" cy="100" r="80" fill="url(#glow)" opacity="0.08"/>
      <defs>
        <radialGradient id="glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#c9a84c"/>
          <stop offset="100%" stop-color="transparent"/>
        </radialGradient>
      </defs>
    </svg>
  </div>

  <h1 class="hero-title">Le Roulv<br/><span>Ghost</span></h1>
  <p class="hero-sub" data-i18n="hero_sub">Born from faith. Built on imperfection.</p>

  <div class="hero-scroll">
    <div class="scroll-line"></div>
    <span data-i18n="scroll">Scroll</span>
  </div>
</section>

<!-- ══ MANIFESTO ══ -->
<section id="manifesto">
  <div class="manifesto-inner reveal">
    <div class="section-label" data-i18n="manifesto_label">Manifesto</div>
