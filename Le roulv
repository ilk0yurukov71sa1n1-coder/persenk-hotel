document.addEventListener('mousemove', e => {
  cursor.style.left = e.clientX + 'px';
  cursor.style.top = e.clientY + 'px';
  setTimeout(() => {
    ring.style.left = e.clientX + 'px';
    ring.style.top = e.clientY + 'px';
  }, 60);
});

/* ─── SCROLL REVEAL ─── */
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) e.target.classList.add('visible');
  });
}, { threshold: 0.12 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

/* ─── CANVAS: WATER + STARS ─── */
(function initCanvas() {
  const canvas = document.getElementById('bg-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, stars = [], waves = [];

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  // Stars
  function initStars() {
    stars = [];
    for (let i = 0; i < 260; i++) {
      stars.push({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() * 1.4 + 0.2,
        alpha: Math.random() * 0.7 + 0.1,
        speed: Math.random() * 0.004 + 0.001,
        phase: Math.random() * Math.PI * 2
      });
    }
  }

  // Wave parameters
  const waveCount = 6;
  function initWaves() {
    waves = [];
    for (let i = 0; i < waveCount; i++) {
      waves.push({
        y: H * (0.45 + i * 0.12),
        amp: 18 + i * 8,
        freq: 0.004 - i * 0.0003,
        speed: 0.0008 + i * 0.0003,
        phase: Math.random() * Math.PI * 2,
        alpha: 0.07 - i * 0.009
      });
    }
  }

  initStars();
  initWaves();

  let tick = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Stars
    stars.forEach(s => {
      s.phase += s.speed;
      const a = s.alpha * (0.7 + 0.3 * Math.sin(s.phase));
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(230, 215, 170, ${a})`;
      ctx.fill();
    });

    // Gold star clusters
    if (tick % 180 === 0) {
      ctx.save();
      const sx = Math.random() * W;
      const sy = Math.random() * H * 0.5;
      const grd = ctx.createRadialGradient(sx, sy, 0, sx, sy, 60);
      grd.addColorStop(0, 'rgba(201,168,76,0.08)');
      grd.addColorStop(1, 'transparent');
      ctx.fillStyle = grd;
      ctx.fillRect(sx - 60, sy - 60, 120, 120);
      ctx.restore();
    }

    // Water waves
    waves.forEach((w, i) => {
      w.phase += w.speed;
      ctx.beginPath();
      ctx.moveTo(0, H);
      for (let x = 0; x <= W; x += 4) {
        const y = w.y + Math.sin(x * w.freq + w.phase) * w.amp
                      + Math.sin(x * w.freq * 1.7 + w.phase * 0.7) * w.amp * 0.4;
        ctx.lineTo(x, y);
      }
      ctx.lineTo(W, H);
      ctx.closePath();

      const wGrad = ctx.createLinearGradient(0, w.y - w.amp, 0, w.y + w.amp + 20);
      wGrad.addColorStop(0, `rgba(100, 160, 220, ${w.alpha * 1.2})`);
      wGrad.addColorStop(0.5, `rgba(60, 120, 180, ${w.alpha})`);
      wGrad.addColorStop(1, `rgba(30, 60, 120, ${w.alpha * 0.4})`);
      ctx.fillStyle = wGrad;
      ctx.fill();
    });

    // Subtle ambient glow bottom
    const botGrad = ctx.createLinearGradient(0, H * 0.7, 0, H);
    botGrad.addColorStop(0, 'transparent');
    botGrad.addColorStop(1, 'rgba(13, 30, 55, 0.7)');
    ctx.fillStyle = botGrad;
    ctx.fillRect(0, H * 0.7, W, H * 0.3);

    tick++;
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>
</body>
</html>
