cat > /home/claude/build.py << 'BUILDEOF'
import base64, os

def b64(p):
    with open(p,'rb') as f:
        return "data:image/jpeg;base64,"+base64.b64encode(f.read()).decode()

U = '/mnt/user-data/uploads/'
imgs = {k:b64(U+v) for k,v in {
    'hero':'IMG_5044.jpeg','entrance':'IMG_5173.jpeg',
    'lobby':'IMG_5047.jpeg','corridor':'IMG_5172.jpeg',
    'room':'IMG_5043.jpeg','pool_main':'IMG_5042.jpeg',
    'jacuzzi':'IMG_5050.jpeg','mineral':'IMG_5049.jpeg',
    'sauna':'IMG_5045.jpeg','salt':'IMG_5052.jpeg',
    'banquet':'IMG_5048.jpeg','terrace':'IMG_5051.jpeg',
    'nightbar':'IMG_5046.jpeg'
}.items()}
print("Images loaded:", sum(len(v) for v in imgs.values())//1024,"KB")

CSS = r"""
:root{--g:#c4a35a;--gl:#dbbe80;--gd:rgba(196,163,90,.13);--k:#04040b;--k2:#080810;--k3:#0c0c18;--w:#f2ebe0;--wm:rgba(242,235,224,.6);--wf:rgba(242,235,224,.28)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--k);color:var(--w);font-family:'Jost',sans-serif;font-weight:300;overflow-x:hidden;cursor:none}

/* CURSOR */
#cur{position:fixed;width:9px;height:9px;background:var(--g);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:screen;transition:width .2s,height .2s}
#cur2{position:fixed;width:42px;height:42px;border:1px solid rgba(196,163,90,.55);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%)}

/* STARS */
#stars{position:fixed;inset:0;z-index:0;pointer-events:none}

/* GRAIN */
body::before{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.038'/%3E%3C/svg%3E");
  opacity:.42}

main{position:relative;z-index:2}

/* ═══ NAV ═══ */
nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:28px 64px;transition:padding .6s cubic-bezier(.22,1,.36,1),background .6s,border-color .6s;border-bottom:1px solid transparent}
nav.solid{background:rgba(4,4,11,.94);backdrop-filter:blur(28px);padding:14px 64px;border-color:rgba(196,163,90,.1)}
.nlogo{font-family:'Cinzel',serif;font-size:15px;letter-spacing:6px;color:var(--g);text-decoration:none;transition:opacity .3s}
.nlogo:hover{opacity:.72}
.nl{display:flex;gap:32px;list-style:none}
.nl a{font-family:'Cinzel',serif;font-size:8.5px;letter-spacing:3.5px;text-decoration:none;color:rgba(242,235,224,.55);text-transform:uppercase;transition:color .3s}
.nl a:hover{color:var(--g)}
.nav-right{display:flex;align-items:center;gap:16px}

/* LANG TOGGLE */
.lang-toggle{display:flex;align-items:center;gap:0;border:1px solid rgba(196,163,90,.35);border-radius:2px;overflow:hidden;font-family:'Cinzel',serif;font-size:8px;letter-spacing:2.5px}
.lang-btn{padding:9px 14px;cursor:none;transition:background .3s,color .3s;color:rgba(242,235,224,.45);text-transform:uppercase;user-select:none}
.lang-btn.active{background:var(--g);color:var(--k);font-weight:600}
.lang-btn:hover:not(.active){background:rgba(196,163,90,.12);color:var(--g)}
.lang-sep{width:1px;height:100%;background:rgba(196,163,90,.3);flex-shrink:0}
.nbtn{font-family:'Cinzel',serif;font-size:8.5px;letter-spacing:3px;text-decoration:none;color:var(--k);background:var(--g);padding:12px 28px;text-transform:uppercase;transition:all .35s cubic-bezier(.22,1,.36,1)}
.nbtn:hover{background:var(--gl);transform:translateY(-1px);box-shadow:0 10px 40px rgba(196,163,90,.28)}

/* ═══ HERO ═══ */
#hero{height:100vh;position:relative;overflow:hidden;display:flex;align-items:flex-end}
.hbg{position:absolute;inset:0;filter:brightness(.45) saturate(.8);transform:scale(1.08);transition:transform 15s ease,filter 1.5s}
.hbg.ready{transform:scale(1)}
.hvig{position:absolute;inset:0;background:linear-gradient(to top,rgba(4,4,11,.97) 0%,rgba(4,4,11,.52) 32%,rgba(4,4,11,.12) 62%,rgba(4,4,11,.28) 100%)}
.hcontent{position:relative;z-index:3;padding:0 80px 88px;width:100%;display:flex;align-items:flex-end;justify-content:space-between}
.hleft{max-width:800px}
.heyebrow{font-family:'Cinzel',serif;font-size:9px;letter-spacing:8px;color:var(--g);text-transform:uppercase;display:flex;align-items:center;gap:18px;margin-bottom:22px;opacity:0;transform:translateX(-20px);animation:slix .9s .4s cubic-bezier(.22,1,.36,1) forwards}
.heyebrow::before{content:'';width:36px;height:1px;background:var(--g)}
.htitle{font-family:'Cormorant Garamond',serif;font-size:clamp(78px,11vw,154px);font-weight:300;line-height:.86;letter-spacing:-4px;opacity:0;transform:translateY(44px);animation:fupp 1.1s .6s cubic-bezier(.22,1,.36,1) forwards}
.htitle em{font-style:italic;color:var(--gl);display:block;font-size:.76em}
.hsub{margin-top:30px;font-weight:200;font-size:12px;letter-spacing:5px;color:var(--wm);text-transform:uppercase;opacity:0;animation:fupp .8s 1s cubic-bezier(.22,1,.36,1) forwards}
.hright{opacity:0;animation:fupp .7s 1.3s cubic-bezier(.22,1,.36,1) forwards}
.hstars{color:var(--g);font-size:18px;letter-spacing:7px;text-align:right}
.hstars-label{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--wf);text-transform:uppercase;margin-top:5px;text-align:right}
.hscroll{position:absolute;right:52px;top:50%;transform:translateY(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:fupp .7s 1.7s forwards}
.hscroll-txt{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--wf);writing-mode:vertical-rl}
.hscroll-ln{width:1px;height:64px;background:linear-gradient(to bottom,var(--g),transparent);animation:scpulse 2.2s infinite}
@keyframes scpulse{0%,100%{opacity:.2}50%{opacity:1}}

/* ═══ TICKER ═══ */
.tk{overflow:hidden;padding:14px 0;border-top:1px solid rgba(196,163,90,.09);border-bottom:1px solid rgba(196,163,90,.09);background:rgba(4,4,11,.4)}
.tkt{display:flex;white-space:nowrap;animation:tickr 32s linear infinite}
.tkt span{font-family:'Cinzel',serif;font-size:8px;letter-spacing:6px;color:var(--g);text-transform:uppercase;padding:0 52px}
.tkt span::after{content:'◆';margin-left:52px;opacity:.35;font-size:6px}
@keyframes tickr{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* REVEAL */
.rv{opacity:0;transform:translateY(50px)}.rl{opacity:0;transform:translateX(-52px)}.rr{opacity:0;transform:translateX(52px)}
.rv,.rl,.rr{transition:opacity 1s cubic-bezier(.22,1,.36,1),transform 1s cubic-bezier(.22,1,.36,1)}
.rv.on,.rl.on,.rr.on{opacity:1;transform:none}
.d1{transition-delay:.06s!important}.d2{transition-delay:.15s!important}.d3{transition-delay:.25s!important}.d4{transition-delay:.36s!important}.d5{transition-delay:.48s!important}

/* SECTION */
section{padding:124px 0;position:relative}
.W{max-width:1300px;margin:0 auto;padding:0 68px}
.ey{font-family:'Cinzel',serif;font-size:8px;letter-spacing:5.5px;color:var(--g);text-transform:uppercase;display:flex;align-items:center;gap:14px;margin-bottom:18px}
.ey::before{content:'';width:26px;height:1px;background:var(--g)}
.H{font-family:'Cormorant Garamond',serif;font-size:clamp(46px,5.5vw,82px);font-weight:300;line-height:1.0}
.H em{font-style:italic;color:var(--gl)}
.bod{font-size:13.5px;line-height:1.95;color:var(--wm);max-width:510px}
.pill{display:inline-flex;align-items:center;gap:12px;font-family:'Cinzel',serif;font-size:8px;letter-spacing:3px;color:var(--g);text-decoration:none;text-transform:uppercase}
.pill::after{content:'';width:28px;height:1px;background:var(--g);transition:width .35s cubic-bezier(.22,1,.36,1)}
.pill:hover::after{width:52px}

/* ABOUT */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:84px;align-items:center}
.photo-frame{position:relative;overflow:hidden}
.photo-frame::before{content:'';position:absolute;top:-18px;left:-18px;right:18px;bottom:18px;border:1px solid rgba(196,163,90,.25);pointer-events:none;z-index:2;transition:transform .5s cubic-bezier(.22,1,.36,1)}
.photo-frame:hover::before{transform:translate(4px,-4px)}
.photo-frame img{width:100%;height:560px;object-fit:cover;display:block;filter:brightness(.88) saturate(.9);transition:filter .6s,transform 7s ease}
.photo-frame:hover img{filter:brightness(.97) saturate(1);transform:scale(1.025)}
.ptag{position:absolute;bottom:0;left:0;z-index:3;background:var(--g);color:var(--k);font-family:'Cinzel',serif;font-size:7px;letter-spacing:4px;padding:12px 22px;text-transform:uppercase}
.stat-row{display:flex;gap:0;margin-top:48px;padding-top:36px;border-top:1px solid rgba(196,163,90,.12)}
.stat{flex:1;padding-right:24px}
.stat:not(:last-child){border-right:1px solid rgba(196,163,90,.1);margin-right:24px}
.stat-n{font-family:'Cormorant Garamond',serif;font-size:54px;font-weight:300;color:var(--g);line-height:1}
.stat-l{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--wf);text-transform:uppercase;margin-top:7px}

/* LOBBY */
.lobby-scene{position:relative;height:78vh;overflow:hidden}
.lobby-scene img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.72) saturate(.85);transition:transform 9s ease}
.lobby-scene:hover img{transform:scale(1.03)}
.lobby-scene-over{position:absolute;inset:0;background:linear-gradient(to top,rgba(4,4,11,.9) 0%,rgba(4,4,11,.28) 38%,transparent 65%);display:flex;align-items:flex-end;padding:56px 80px}
.lobby-badge{position:absolute;top:36px;right:44px;background:rgba(4,4,11,.72);backdrop-filter:blur(16px);border:1px solid rgba(196,163,90,.3);padding:20px 28px;text-align:center}
.lb-yr{font-family:'Cormorant Garamond',serif;font-size:42px;color:var(--g);line-height:1;font-weight:300}
.lb-tx{font-family:'Cinzel',serif;font-size:6.5px;letter-spacing:2px;color:var(--wf);text-transform:uppercase;margin-top:6px}
.corridor-strip{height:300px;position:relative;overflow:hidden}
.corridor-strip img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.68) saturate(.8)}
.corridor-strip-over{position:absolute;inset:0;background:linear-gradient(to right,rgba(4,4,11,.82) 0%,rgba(4,4,11,.2) 50%,rgba(4,4,11,.6) 100%);display:flex;align-items:center;padding:0 80px}

/* ROOMS */
.rooms-layout{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.room-photo{position:relative;overflow:hidden}
.room-photo img{width:100%;height:600px;object-fit:cover;display:block;filter:brightness(.9) saturate(.9);transition:filter .6s,transform 7s ease}
.room-photo:hover img{filter:brightness(.98) saturate(1);transform:scale(1.03)}
.room-photo .rtag{position:absolute;bottom:20px;left:20px;z-index:2;background:rgba(4,4,11,.82);backdrop-filter:blur(12px);border:1px solid rgba(196,163,90,.25);font-family:'Cinzel',serif;font-size:7.5px;letter-spacing:4px;color:var(--g);padding:12px 20px;text-transform:uppercase}
.room-feats{display:flex;flex-direction:column;gap:0;margin-top:36px}
.rf{display:flex;align-items:center;gap:15px;padding:15px 0;border-bottom:1px solid rgba(196,163,90,.07);font-size:13px;color:var(--wm)}
.rf::before{content:'◈';color:var(--g);font-size:10px;flex-shrink:0}

/* SPA */
.spa-intro{display:grid;grid-template-columns:58% 42%;min-height:680px}
.spa-photo{position:relative;overflow:hidden}
.spa-photo img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.82) saturate(.88);transition:filter .6s,transform 9s ease}
.spa-photo:hover img{filter:brightness(.92) saturate(1);transform:scale(1.03)}
.spa-caption{position:absolute;bottom:28px;right:-1px;background:var(--g);color:var(--k);font-family:'Cinzel',serif;font-size:7.5px;letter-spacing:4px;padding:12px 22px;text-transform:uppercase;z-index:2}
.spa-text{background:var(--k2);display:flex;flex-direction:column;justify-content:center;padding:72px 60px;border-left:1px solid rgba(196,163,90,.07)}
.spa-services{display:flex;flex-direction:column;gap:0;margin-top:36px}
.sv{display:flex;gap:18px;align-items:flex-start;padding:20px 0;border-bottom:1px solid rgba(196,163,90,.07)}
.sv:last-child{border:none}
.sv-ic{width:38px;height:38px;border:1px solid rgba(196,163,90,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;flex-shrink:0;color:var(--g);transition:background .3s}
.sv:hover .sv-ic{background:rgba(196,163,90,.1)}
.sv-name{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:400;margin-bottom:4px}
.sv-desc{font-size:12px;color:var(--wm);line-height:1.65}

/* SPA GALLERY */
.spa-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;background:var(--k)}
.sg{position:relative;overflow:hidden;height:460px;cursor:none}
.sg img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.72) saturate(.85);transition:filter .6s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1)}
.sg:hover img{filter:brightness(.92) saturate(1);transform:scale(1.06)}
.sg-over{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(4,4,11,.9) 0%,rgba(4,4,11,.3) 45%,transparent 70%);padding:24px 22px 20px;transition:padding .4s}
.sg:hover .sg-over{padding:20px 22px 24px}
.sg-tag{font-family:'Cinzel',serif;font-size:7px;letter-spacing:4px;color:var(--g);text-transform:uppercase;margin-bottom:8px}
.sg-name{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:300;line-height:1.2}
.sg-desc{font-size:11.5px;color:var(--wm);line-height:1.6;margin-top:8px;max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.22,1,.36,1)}
.sg:hover .sg-desc{max-height:80px}

/* DINING */
.dining-h{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:end;margin-bottom:72px}
.dining-mosaic{display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-template-rows:340px 340px;gap:4px}
.dm{position:relative;overflow:hidden;cursor:none}
.dm:nth-child(1){grid-row:span 2}
.dm img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.7) saturate(.82);transition:filter .6s cubic-bezier(.22,1,.36,1),transform .8s cubic-bezier(.22,1,.36,1)}
.dm:hover img{filter:brightness(.9) saturate(1);transform:scale(1.05)}
.dm-over{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,rgba(4,4,11,.88),transparent 56%);padding:22px 20px 18px}
.dm-name{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:300}
.dm:nth-child(1) .dm-over{padding:36px 30px 28px}
.dm:nth-child(1) .dm-name{font-size:28px}
.dine-num{margin-top:56px;display:flex;align-items:flex-end;gap:28px}
.dn{font-family:'Cormorant Garamond',serif;font-size:clamp(110px,15vw,190px);font-weight:300;line-height:1;color:transparent;-webkit-text-stroke:1px rgba(196,163,90,.2)}
.dn-text{padding-bottom:22px}
.dn-title{font-family:'Cormorant Garamond',serif;font-size:36px;font-weight:300;color:var(--gl);margin-bottom:10px}
.dn-sub{font-size:12.5px;color:var(--wm);line-height:1.75;max-width:300px}

/* ROOFTOP */
#rooftop{padding:0;position:relative;overflow:hidden;min-height:620px;display:flex;align-items:center}
.rt-bg{position:absolute;inset:0;filter:brightness(.38) saturate(.7);transition:transform .1s}
.rt-over{position:absolute;inset:0;background:linear-gradient(135deg,rgba(4,4,11,.82) 0%,rgba(4,4,11,.25) 50%,rgba(4,4,11,.6) 100%)}
.rt-content{position:relative;z-index:2;padding:80px;display:flex;gap:80px;align-items:center;width:100%}
.rt-l{max-width:520px}
.rt-r{flex:1;display:flex;flex-direction:column;gap:20px}
.rtf{background:rgba(4,4,11,.6);backdrop-filter:blur(16px);border:1px solid rgba(196,163,90,.15);padding:22px 26px;display:flex;gap:16px;align-items:flex-start;transition:border-color .3s,background .3s}
.rtf:hover{border-color:rgba(196,163,90,.35);background:rgba(4,4,11,.75)}
.rtf-ic{font-size:22px;flex-shrink:0;line-height:1}
.rtf-n{font-family:'Cinzel',serif;font-size:8.5px;letter-spacing:2px;color:var(--g);text-transform:uppercase;margin-bottom:5px}
.rtf-d{font-size:12px;color:var(--wm);line-height:1.6}

/* NIGHT BAR */
.nb-split{display:grid;grid-template-columns:1fr 1fr;min-height:620px}
.nb-img{position:relative;overflow:hidden}
.nb-img img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.75) saturate(.85);transition:filter .6s,transform 8s ease}
.nb-img:hover img{filter:brightness(.9) saturate(1);transform:scale(1.03)}
.nb-text{background:var(--k2);display:flex;flex-direction:column;justify-content:center;padding:80px 68px;border-left:1px solid rgba(196,163,90,.07)}
.nb-items{display:flex;flex-direction:column;gap:0;margin-top:36px}
.nbi{display:flex;align-items:center;gap:16px;padding:16px 0;border-bottom:1px solid rgba(196,163,90,.07);font-size:13.5px;color:var(--wm)}
.nbi:last-child{border:none}
.nbi::before{content:'◆';color:var(--g);font-size:7px;flex-shrink:0}

/* AQUAPARK */
#aquapark{padding:0;position:relative;overflow:hidden;min-height:540px;display:flex;align-items:center}
.ap-bg{position:absolute;inset:0;filter:brightness(.32) saturate(.65)}
.ap-over{position:absolute;inset:0;background:linear-gradient(to right,rgba(4,4,11,.9) 0%,rgba(4,4,11,.4) 55%,rgba(4,4,11,.15) 100%)}
.ap-content{position:relative;z-index:2;padding:0 80px;max-width:640px}
.ap-nums{display:flex;gap:44px;margin-top:40px}
.apn-n{font-family:'Cormorant Garamond',serif;font-size:56px;color:var(--g);font-weight:300;line-height:1}
.apn-l{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--wf);text-transform:uppercase;margin-top:6px}

/* OFFERS */
.off-h{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:60px}
.off-g{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid rgba(196,163,90,.09);background:rgba(196,163,90,.035);gap:1px}
.oc{background:var(--k);padding:44px 38px;transition:background .4s;cursor:none}
.oc:hover{background:rgba(196,163,90,.04)}
.oc-tag{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--g);text-transform:uppercase;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.oc-tag::before{content:'';width:14px;height:1px;background:var(--g)}
.oc-n{font-family:'Cormorant Garamond',serif;font-size:28px;font-weight:300;line-height:1.1;margin-bottom:14px}
.oc-d{font-size:12.5px;color:var(--wm);line-height:1.8;margin-bottom:28px}

/* AMENITIES */
.am-h{text-align:center;margin-bottom:64px}
.am-h .ey{justify-content:center}.am-h .ey::before{display:none}
.am-g{display:grid;grid-template-columns:repeat(6,1fr);border:1px solid rgba(196,163,90,.07);background:rgba(196,163,90,.03);gap:1px}
.ami{background:var(--k2);padding:34px 20px;text-align:center;transition:background .4s,transform .4s;cursor:none}
.ami:hover{background:rgba(196,163,90,.07);transform:translateY(-4px)}
.ami-ic{font-size:28px;margin-bottom:12px;display:block}
.ami-n{font-family:'Cinzel',serif;font-size:7px;letter-spacing:2px;color:var(--wf);text-transform:uppercase;line-height:1.5}

/* CONFERENCE */
.conf-split{display:grid;grid-template-columns:1fr 1fr;min-height:560px}
.conf-img{position:relative;overflow:hidden}
.conf-img img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(.82) saturate(.88);transition:filter .6s,transform 8s ease}
.conf-img:hover img{filter:brightness(.95) saturate(1);transform:scale(1.03)}
.conf-text{background:linear-gradient(135deg,rgba(196,163,90,.05),transparent);display:flex;flex-direction:column;justify-content:center;padding:80px 68px;border:1px solid rgba(196,163,90,.07);border-left:none}
.conf-feats{display:flex;flex-direction:column;gap:12px;margin-top:32px}
.cf{display:flex;align-items:center;gap:14px;font-size:13px;color:var(--wm)}
.cf::before{content:'';width:5px;height:5px;background:var(--g);border-radius:50%;flex-shrink:0}

/* LOCATION */
.loc-g{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.loc-items{display:flex;flex-direction:column;gap:0;margin-top:40px}
.li{display:flex;gap:20px;padding:22px 0;border-bottom:1px solid rgba(196,163,90,.07)}
.li:last-child{border:none;padding-bottom:0}
.li-ic{width:46px;height:46px;border:1px solid rgba(196,163,90,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.li-t{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--g);text-transform:uppercase;margin-bottom:6px}
.li-v{font-size:13.5px;line-height:1.5}
.dist-g{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.dg{background:rgba(196,163,90,.04);border:1px solid rgba(196,163,90,.09);padding:22px}
.dg-n{font-family:'Cormorant Garamond',serif;font-size:44px;color:var(--g);font-weight:300;line-height:1}
.dg-n span{font-size:16px}
.dg-f{font-size:10.5px;color:var(--wm);margin-top:4px;letter-spacing:1px}
.price-box{margin-top:18px;padding:28px 32px;background:rgba(196,163,90,.05);border:1px solid rgba(196,163,90,.12)}
.pb-label{font-size:12px;color:var(--wm);margin-bottom:4px}
.pb-price{font-family:'Cormorant Garamond',serif;font-size:60px;color:var(--g);font-weight:300;line-height:1}
.pb-price span{font-size:17px;color:var(--wm)}
.pb-note{font-size:10.5px;color:var(--wf);margin-top:6px}
.lm-box{margin-top:18px;padding:24px 28px;background:rgba(196,163,90,.03);border:1px solid rgba(196,163,90,.08)}
.lm-title{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--g);text-transform:uppercase;margin-bottom:16px}
.lm-list{display:flex;flex-direction:column;gap:10px}
.lm-item{display:flex;align-items:center;gap:12px;font-size:12.5px;color:var(--wm)}
.lm-item::before{content:'';width:4px;height:4px;background:var(--g);border-radius:50%;flex-shrink:0}

/* REVIEWS */
.rv-h{text-align:center;margin-bottom:60px}
.rv-h .ey{justify-content:center}.rv-h .ey::before{display:none}
.rv-scroll{display:flex;gap:20px;overflow-x:auto;padding-bottom:8px;scrollbar-width:none}
.rv-scroll::-webkit-scrollbar{display:none}
.rc{background:rgba(196,163,90,.04);border:1px solid rgba(196,163,90,.09);padding:40px 36px;min-width:370px;flex-shrink:0;transition:border-color .4s,transform .4s}
.rc:hover{border-color:rgba(196,163,90,.22);transform:translateY(-4px)}
.rc-stars{color:var(--g);font-size:13px;letter-spacing:6px;margin-bottom:20px}
.rc-text{font-family:'Cormorant Garamond',serif;font-size:17.5px;font-style:italic;color:var(--wm);line-height:1.72;margin-bottom:24px}
.rc-auth{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--g);text-transform:uppercase}

/* CTA */
#cta{position:relative;min-height:540px;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center}
.cta-bg{position:absolute;inset:0;filter:brightness(.22) saturate(.5)}
.cta-over{position:absolute;inset:0;background:radial-gradient(ellipse at center,rgba(4,4,11,.3) 0%,rgba(4,4,11,.7) 100%)}
.cta-c{position:relative;z-index:2;padding:0 24px}
.cta-c .H{font-size:clamp(60px,8vw,108px)}
.cta-btn{display:inline-block;margin-top:44px;font-family:'Cinzel',serif;font-size:10px;letter-spacing:5px;text-decoration:none;color:var(--k);background:var(--g);padding:20px 64px;text-transform:uppercase;transition:all .4s cubic-bezier(.22,1,.36,1)}
.cta-btn:hover{background:var(--gl);transform:translateY(-3px);box-shadow:0 24px 64px rgba(196,163,90,.32)}

/* FOOTER */
footer{background:var(--k2);border-top:1px solid rgba(196,163,90,.08);padding:80px 0 44px}
.fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:56px;margin-bottom:64px}
.fl{font-family:'Cinzel',serif;font-size:16px;letter-spacing:6px;color:var(--g);margin-bottom:20px}
.fd{font-size:12.5px;color:var(--wm);line-height:1.82;margin-bottom:24px}
.fsoc{display:flex;gap:10px}
.fsc{width:38px;height:38px;border:1px solid rgba(196,163,90,.22);border-radius:50%;display:flex;align-items:center;justify-content:center;text-decoration:none;color:var(--g);font-size:13px;transition:all .3s}
.fsc:hover{background:var(--g);color:var(--k);transform:translateY(-2px)}
.fct{font-family:'Cinzel',serif;font-size:7.5px;letter-spacing:3px;color:var(--g);text-transform:uppercase;margin-bottom:20px}
.fcl{list-style:none;display:flex;flex-direction:column;gap:11px}
.fcl a{font-size:12.5px;color:var(--wm);text-decoration:none;transition:color .3s}
.fcl a:hover{color:var(--w)}
.fbot{border-top:1px solid rgba(196,163,90,.07);padding-top:28px;display:flex;justify-content:space-between;align-items:center}
.fcp{font-size:10.5px;color:rgba(242,235,224,.22);letter-spacing:1px}
.faw{font-family:'Cinzel',serif;font-size:7.5px;letter-spacing:4px;color:var(--g);display:flex;align-items:center;gap:10px}
.faw::before,.faw::after{content:'★';color:rgba(196,163,90,.4)}

/* === LANGUAGE SELECTOR BOTTOM LEFT === */
.lang-select-wrapper {
  position: fixed;
  bottom: 24px;
  left: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 9999;
}

.lang-text-label {
  color: rgba(255, 255, 255, 0.7);
  font-size: 14px;
  font-family: sans-serif;
  margin-left: 4px;
}

/* ═══ AI CHAT ═══ */
#chat-fab{position:fixed;bottom:32px;right:32px;z-index:1000;width:60px;height:60px;background:var(--g);border-radius:50%;border:none;cursor:none;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 32px rgba(196,163,90,.4);transition:transform .35s cubic-bezier(.22,1,.36,1),box-shadow .35s,background .3s}
#chat-fab:hover{transform:scale(1.1) translateY(-2px);box-shadow:0 16px 48px rgba(196,163,90,.5);background:var(--gl)}
#chat-fab svg{width:26px;height:26px;fill:var(--k);transition:opacity .3s}
#chat-fab .close-icon{display:none}
#chat-fab.open .chat-icon{display:none}
#chat-fab.open .close-icon{display:block}
.fab-pulse{position:absolute;inset:-6px;border-radius:50%;border:2px solid rgba(196,163,90,.4);animation:fabpulse 2.5s infinite}
@keyframes fabpulse{0%,100%{opacity:.6;transform:scale(1)}60%{opacity:0;transform:scale(1.5)}}

#chat-win{position:fixed;bottom:108px;right:32px;z-index:1000;width:400px;height:580px;background:rgba(8,8,16,.97);backdrop-filter:blur(32px);border:1px solid rgba(196,163,90,.2);border-radius:4px;display:flex;flex-direction:column;box-shadow:0 32px 80px rgba(0,0,0,.7),0 0 0 1px rgba(196,163,90,.06);opacity:0;transform:translateY(24px) scale(.97);pointer-events:none;transition:opacity .4s cubic-bezier(.22,1,.36,1),transform .4s cubic-bezier(.22,1,.36,1)}
#chat-win.open{opacity:1;transform:none;pointer-events:all}
.chat-head{padding:20px 24px 18px;border-bottom:1px solid rgba(196,163,90,.12);display:flex;align-items:center;gap:14px;flex-shrink:0}
.chat-head-avatar{width:42px;height:42px;border-radius:50%;border:1px solid rgba(196,163,90,.35);display:flex;align-items:center;justify-content:center;font-size:18px;background:rgba(196,163,90,.08);flex-shrink:0}
.chat-head-info{}
.chat-head-name{font-family:'Cinzel',serif;font-size:10px;letter-spacing:3px;color:var(--g);text-transform:uppercase}
.chat-head-status{font-size:10px;color:var(--wf);margin-top:3px;display:flex;align-items:center;gap:6px}
.chat-head-dot{width:6px;height:6px;background:#4ade80;border-radius:50%;flex-shrink:0;animation:dotpulse 2s infinite}
@keyframes dotpulse{0%,100%{opacity:1}50%{opacity:.4}}
.chat-head-stars{margin-left:auto;color:var(--g);font-size:10px;letter-spacing:3px}
.chat-messages{flex:1;overflow-y:auto;padding:20px 20px 12px;display:flex;flex-direction:column;gap:14px;scrollbar-width:thin;scrollbar-color:rgba(196,163,90,.2) transparent}
.chat-messages::-webkit-scrollbar{width:3px}
.chat-messages::-webkit-scrollbar-track{background:transparent}
.chat-messages::-webkit-scrollbar-thumb{background:rgba(196,163,90,.25);border-radius:2px}
.msg{display:flex;flex-direction:column;gap:4px;max-width:82%}
.msg.user{align-self:flex-end;align-items:flex-end}
.msg.bot{align-self:flex-start}
.msg-bubble{padding:12px 16px;border-radius:3px;font-size:13px;line-height:1.65}
.msg.bot .msg-bubble{background:rgba(196,163,90,.07);border:1px solid rgba(196,163,90,.12);color:var(--w)}
.msg.user .msg-bubble{background:var(--g);color:var(--k);font-weight:400}
.msg-time{font-family:'Cinzel',serif;font-size:6.5px;letter-spacing:2px;color:var(--wf);text-transform:uppercase}
.typing-indicator{display:flex;gap:5px;padding:14px 16px;background:rgba(196,163,90,.07);border:1px solid rgba(196,163,90,.12);border-radius:3px;align-self:flex-start}
.typing-dot{width:6px;height:6px;background:var(--g);border-radius:50%;opacity:.4;animation:tdot .9s infinite}
.typing-dot:nth-child(2){animation-delay:.18s}
.typing-dot:nth-child(3){animation-delay:.36s}
@keyframes tdot{0%,100%{opacity:.25;transform:translateY(0)}50%{opacity:1;transform:translateY(-4px)}}
.chat-input-area{padding:16px 20px 18px;border-top:1px solid rgba(196,163,90,.1);display:flex;gap:10px;flex-shrink:0}
.chat-input{flex:1;background:rgba(196,163,90,.06);border:1px solid rgba(196,163,90,.18);border-radius:3px;padding:11px 16px;color:var(--w);font-family:'Jost',sans-serif;font-size:13px;font-weight:300;outline:none;transition:border-color .3s;resize:none}
.chat-input::placeholder{color:var(--wf)}
.chat-input:focus{border-color:rgba(196,163,90,.45)}
.chat-send{width:44px;height:44px;background:var(--g);border:none;border-radius:3px;cursor:none;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .3s,transform .3s}
.chat-send:hover{background:var(--gl);transform:scale(1.05)}
.chat-send svg{width:18px;height:18px;fill:var(--k)}
.chat-quick{display:flex;gap:6px;padding:0 20px 14px;flex-wrap:wrap;flex-shrink:0}
.qbtn{font-family:'Cinzel',serif;font-size:6.5px;letter-spacing:1.5px;color:var(--g);background:transparent;border:1px solid rgba(196,163,90,.22);padding:7px 12px;cursor:none;text-transform:uppercase;transition:all .3s;border-radius:2px}
.qbtn:hover{background:rgba(196,163,90,.1);border-color:rgba(196,163,90,.45)}

@keyframes fupp{to{opacity:1;transform:translateY(0)}}
@keyframes slix{to{opacity:1;transform:translateX(0)}}
"""

