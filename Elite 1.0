  const fo = document.getElementById('footer-offers-list');
  if(fo) fo.innerHTML = c.footer_offers.map(x=>`<li><a href="${x.h}" target="_blank">${x.l}</a></li>`).join('');
  const fc = document.getElementById('footer-contact-list');
  if(fc) fc.innerHTML = c.footer_contact.map(x=>`<li><a href="${x.h}" ${x.h.startsWith('http')?'target="_blank"':''} ${x.gold?'style="color:var(--g)"':''}>${x.l}</a></li>`).join('');
  _t('footer-copy', c.footer_copy);
