    chat_sys: `Вие сте личният луксозен консиерж на Хотел Персенк СПА ★★★★★, намиращ се в Девин, България в Родопите на 710 м н.в. Въплъщавате петзвездно гостоприемство — топло, компетентно, изтънчено. Отговаряйте на БЪЛГАРСКИ.\n\nФАКТИ:\n- 5 звезди | 129 стаи и апартаменти | Отворен отново юли 2025\n- Адрес: ул. „Дружба" 10, 4800 Девин | Тел: +359 89 362 8042 | marketing@persenk.eu\n- Настаняване 14:00 | Напускане 12:00 | Цени от €117/нощ (закуска вкл., безплатен паркинг)\n- 198 км от София | 87 км от Пловдив | 35 км от Пампорово\n\nСТАИ: Делукс двойна (с/без балкон), двойна стая, апартамент Персенк, панорамен апартамент, семеен апартамент, ВИП апартаменти.\n\nСПА: Минерални водни терапии (Девин-Беденска вода), халотерапия/солна стая, финландска сауна, закрит басейн с джакузи и стъклен покрив, коридорни минерални басейни, персонализирани програми, бебе СПА.\n\nХРАНЕНЕ: 7 ресторанта и барове — банкетна зала с кристални полилеи, лоби бар, бар до басейна, нощен бар, покривна тераса бар, лятна градина.\n\nРЕКРЕАЦИЯ: Термален аквапарк „Модар" (6 басейна), боулинг, билярд, фитнес, нощен клуб, козметичен салон.\n\nОФЕРТИ: 3=4, Пролет в Девин, Незабравими уикенди, Почивка в делник, Аква ваканция 2026, Петзвезден подарък.\n\nКОНФЕРЕНЦИИ: 2 зали + бизнес център.\n\nЗАБЕЛЕЖИТЕЛНОСТИ: Язовир Въча, Ягодинска пещера, Орлово гнездо, Дяволското гърло.\n\nРЕЗЕРВАЦИИ: https://www.book.persenk.eu\n\nБъдете кратки, топли и елегантни.`
  }
};
"""

MAIN_JS = r"""
/* ═══════════════════════════════════════
   LANGUAGE ENGINE
═══════════════════════════════════════ */
let LANG = localStorage.getItem('persenk_lang') || 'en';

function T(k){ return window.SITE_CONTENT[LANG][k]; }

function setLang(lang){
  LANG = lang;
  localStorage.setItem('persenk_lang', lang);
  document.documentElement.lang = T('htmlLang');
  document.querySelectorAll('.lang-btn').forEach(b=>{
    b.classList.toggle('active', b.dataset.lang === lang);
  });
  renderAll();
}

function h(str){ return str; } /* pass-through — HTML allowed in content */

/* ─── RENDER FUNCTIONS ─── */

function renderNav(){
  const c = window.SITE_CONTENT[LANG];
  const links = ['hotel','rooms','spa','dining','offers','location'];
  const hrefs = ['#about','#rooms','#spa','#dining','#offers','#loc'];
  document.querySelectorAll('.nl li a').forEach((a,i)=>{
    a.textContent = c['nav_'+links[i]];
    a.href = hrefs[i];
  });
  const btn = document.querySelector('.nbtn');
  if(btn) btn.textContent = c.nav_book;
  const chatHead = document.querySelector('.chat-head-name');
  if(chatHead) chatHead.textContent = c.chat_name;
  const chatStatus = document.querySelector('.chat-head-status-txt');
  if(chatStatus) chatStatus.textContent = c.chat_status;
  const chatInput = document.querySelector('.chat-input');
  if(chatInput) chatInput.placeholder = c.chat_placeholder;
  renderQuickBtns();
}

function renderHero(){
  const c = window.SITE_CONTENT[LANG];
  const ey = document.getElementById('hero-eyebrow');
  if(ey) ey.innerHTML = c.hero_eyebrow;
  const t = document.getElementById('hero-title');
  if(t) t.childNodes[0].textContent = c.hero_title + ' ';
  const em = document.getElementById('hero-em');
  if(em) em.textContent = c.hero_em;
  const sub = document.getElementById('hero-sub');
  if(sub) sub.innerHTML = c.hero_sub;
  const sl = document.getElementById('hero-stars-label');
  if(sl) sl.textContent = c.hero_stars_label;
}

function renderTicker(){
  const wrap = document.getElementById('ticker-inner');
