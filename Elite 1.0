}

/* ═══════════════════════════════════════
   AI CONCIERGE CHAT
═══════════════════════════════════════ */
const chatFab  = document.getElementById('chat-fab');
const chatWin  = document.getElementById('chat-win');
const chatMsgs = document.getElementById('chat-messages');
const chatInp  = document.querySelector('.chat-input');
const chatSend = document.querySelector('.chat-send');

let chatOpen = false;
let chatHistory = [];
let chatInitialized = false;

function toggleChat(){
  chatOpen = !chatOpen;
  chatFab.classList.toggle('open', chatOpen);
  chatWin.classList.toggle('open', chatOpen);
  if(chatOpen && !chatInitialized){
    chatInitialized = true;
    const welcome = window.SITE_CONTENT[LANG].chat_welcome;
    addMsg(welcome, 'bot');
  }
  if(chatOpen) setTimeout(()=>chatInp.focus(), 400);
}

function addMsg(text, role){
  const now = new Date().toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
  const div = document.createElement('div');
  div.className = `msg ${role}`;
  div.innerHTML = `<div class="msg-bubble">${text}</div><div class="msg-time">${now}</div>`;
  chatMsgs.appendChild(div);
  chatMsgs.scrollTop = chatMsgs.scrollHeight;
}

function addTyping(){
  const div = document.createElement('div');
  div.className = 'typing-indicator';
  div.id = 'typing';
  div.innerHTML = '<div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>';
  chatMsgs.appendChild(div);
  chatMsgs.scrollTop = chatMsgs.scrollHeight;
  return div;
}

async function sendMsg(text){
  if(!text || !text.trim()) return;
  const userText = text.trim();
  chatInp.value = '';
  addMsg(userText, 'user');
  chatHistory.push({ role:'user', content: userText });

  const typing = addTyping();
  const sys = window.SITE_CONTENT[LANG].chat_sys;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: sys,
        messages: chatHistory
      })
    });
    const data = await res.json();
    typing.remove();
    const reply = data.content && data.content[0] ? data.content[0].text : '…';
    addMsg(reply, 'bot');
    chatHistory.push({ role:'assistant', content: reply });
  } catch(e) {
    typing.remove();
    addMsg('I apologise — a connection issue occurred. Please try again shortly.', 'bot');
  }
}

function sendQuick(text){ sendMsg(text); }

chatFab.addEventListener('click', toggleChat);
chatSend.addEventListener('click', ()=>sendMsg(chatInp.value));
chatInp.addEventListener('keydown', e=>{ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMsg(chatInp.value); }});

/* ═══════════════════════════════════════
   CURSOR
═══════════════════════════════════════ */
const cur=document.getElementById('cur'),cur2=document.getElementById('cur2');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;cur.style.left=mx+'px';cur.style.top=my+'px'});
(function loop(){rx+=(mx-rx)*.1;ry+=(my-ry)*.1;cur2.style.left=rx+'px';cur2.style.top=ry+'px';requestAnimationFrame(loop)})();
document.querySelectorAll('a,button,.lang-btn').forEach(el=>{
  el.addEventListener('mouseenter',()=>{cur.style.width='18px';cur.style.height='18px';cur2.style.width='58px';cur2.style.height='58px'});
  el.addEventListener('mouseleave',()=>{cur.style.width='9px';cur.style.height='9px';cur2.style.width='42px';cur2.style.height='42px'});
});

/* ═══════════════════════════════════════
   STARS
═══════════════════════════════════════ */
const sc=document.getElementById('stars'),cx=sc.getContext('2d');
function resize(){sc.width=innerWidth;sc.height=innerHeight}
resize(); window.addEventListener('resize',resize);

const starData=Array.from({length:360},()=>({
  x:Math.random()*sc.width, y:Math.random()*sc.height,
  r:Math.random()*1.4+.1,
  baseA:Math.random()*.75+.08,
  sp:Math.random()*.45+.04,
  ph:Math.random()*Math.PI*2,
  gold:Math.random()>.93,
  vy:.05+Math.random()*.06
}));

class Shooter{
  constructor(){this.reset();this.active=false}
  reset(){this.x=Math.random()*sc.width;this.y=Math.random()*sc.height*.35;this.vx=2+Math.random()*3;this.vy=.8+Math.random()*1.4;this.life=0;this.maxL=50+Math.random()*55;this.active=false}
  draw(){
    if(!this.active)return;
    this.life++;this.x+=this.vx;this.y+=this.vy;
    const a=this.life<20?this.life/20:(this.maxL-this.life)/(this.maxL-20);
    if(a<=0||this.life>=this.maxL){this.active=false;return}
    const g=cx.createLinearGradient(this.x,this.y,this.x-this.vx*10,this.y-this.vy*10);
    g.addColorStop(0,'#c4a35a');g.addColorStop(1,'transparent');
    cx.save();cx.globalAlpha=a*.9;cx.strokeStyle=g;cx.lineWidth=1.6;
    cx.beginPath();cx.moveTo(this.x,this.y);cx.lineTo(this.x-this.vx*12,this.y-this.vy*12);cx.stroke();cx.restore();
  }
}
const shooters=Array.from({length:3},()=>new Shooter());
let t=0,lastShot=0;

function frame(){
  cx.clearRect(0,0,sc.width,sc.height);t+=.014;
  const nb=cx.createRadialGradient(sc.width*.3,sc.height*.2,0,sc.width*.3,sc.height*.2,sc.width*.5);
  nb.addColorStop(0,'rgba(196,163,90,.017)');nb.addColorStop(1,'transparent');
  cx.fillStyle=nb;cx.globalAlpha=1;cx.fillRect(0,0,sc.width,sc.height);
  starData.forEach(s=>{
    s.y-=s.vy;if(s.y<-2){s.y=sc.height+2;s.x=Math.random()*sc.width}
    const a=s.baseA*(.4+.6*Math.sin(t*s.sp+s.ph));
    cx.beginPath();cx.arc(s.x,s.y,s.r,0,Math.PI*2);
    cx.fillStyle=s.gold?'#c4a35a':'#fff';cx.globalAlpha=a;cx.fill();
  });
  cx.globalAlpha=1;
  if(t-lastShot>4+Math.random()*10){const sh=shooters.find(s=>!s.active);if(sh){Object.assign(sh,{x:Math.random()*sc.width,y:Math.random()*sc.height*.35,vx:2+Math.random()*3,vy:.8+Math.random()*1.4,life:0,maxL:50+Math.random()*55,active:true});}lastShot=t;}
  shooters.forEach(s=>s.draw());cx.globalAlpha=1;
  requestAnimationFrame(frame);
}
frame();

/* ═══ NAV ═══ */
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('solid',scrollY>60));

/* ═══ HERO ═══ */
const hbg=document.getElementById('hbg');
hbg.style.backgroundImage=`url('${window.SITE_CONTENT.assets.hero}')`;
setTimeout(()=>hbg.classList.add('ready'),80);

/* Set other bg images */
document.querySelectorAll('[data-bg]').forEach(el=>{
  const key=el.dataset.bg;
  if(window.SITE_CONTENT.assets[key]) el.style.backgroundImage=`url('${window.SITE_CONTENT.assets[key]}')`;
});

window.addEventListener('scroll',()=>{
  const y=scrollY;
  hbg.style.transform=`scale(1.08) translateY(${y*.25}px)`;
  const rtbg=document.getElementById('rtbg');
  if(rtbg){const r=document.getElementById('rooftop').getBoundingClientRect();rtbg.style.transform=`scale(1.04) translateY(${r.top*.1}px)`;}
},{passive:true});

/* ═══ REVEAL ═══ */
let revObs;
function reObserve(){
  if(revObs) revObs.disconnect();
  revObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on')})},{threshold:.07,rootMargin:'0px 0px -44px 0px'});
  document.querySelectorAll('.rv,.rl,.rr').forEach(el=>revObs.observe(el));
}

/* ═══ ANCHOR ═══ */
document.addEventListener('click',e=>{
  const a=e.target.closest('a[href^="#"]');
  if(!a)return;
  const t=document.querySelector(a.getAttribute('href'));
  if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth',block:'start'});}
});

/* ═══ BOOT ═══ */
document.querySelectorAll('.lang-btn').forEach(b=>{
  b.addEventListener('click',()=>setLang(b.dataset.lang));
});
setLang(LANG);
"""

