<!-- ═══ AMENITIES ═══ -->
<section id="amenities" style="background:var(--k2)">
  <div class="W">
    <div class="am-h rv">
      <div class="ey" id="am-ey"></div>
      <h2 class="H"><span id="am-h"></span> <em id="am-em"></em></h2>
      <p class="bod" style="margin:20px auto 0;text-align:center" id="am-b"></p>
    </div>
    <div class="am-g" id="amenities-grid"></div>
  </div>
</section>

<!-- ═══ CONFERENCE ═══ -->
<section id="conf" style="padding:0">
  <div class="conf-split">
    <div class="conf-img rl"><img src="{IMGS['banquet']}" alt="Conference Hall"></div>
    <div class="conf-text rr">
      <div class="ey" id="conf-ey"></div>
      <h2 class="H" style="font-size:clamp(36px,4vw,58px)"><span id="conf-h"></span><br><em id="conf-em"></em></h2>
      <p class="bod" style="margin-top:22px" id="conf-b"></p>
      <div id="conf-feats" class="conf-feats"></div>
      <a href="https://persenk.eu/en/about-us/conference-block/" target="_blank" class="pill" style="margin-top:36px" id="conf-link"></a>
    </div>
  </div>
</section>

<!-- ═══ LOCATION ═══ -->
<section id="loc">
  <div class="W">
    <div class="loc-g">
      <div class="rl">
        <div class="ey" id="loc-ey"></div>
        <h2 class="H"><span id="loc-h"></span><br><em id="loc-em"></em></h2>
        <p class="bod" style="margin-top:22px" id="loc-b"></p>
        <div id="loc-items" class="loc-items"></div>
      </div>
      <div class="rr">
        <div class="dist-g rv" id="dist-grid"></div>
        <div class="price-box rv">
          <div class="pb-label" id="price-label"></div>
          <div class="pb-price">€117 <span>/ night</span></div>
          <div class="pb-note" id="pb-note"></div>
        </div>
        <div class="lm-box rv">
          <div class="lm-title" id="lm-title"></div>
          <div class="lm-list" id="lm-list"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ REVIEWS ═══ -->
<section id="reviews" style="background:var(--k2)">
  <div class="W">
    <div class="rv-h rv">
      <div class="ey" id="rev-ey"></div>
      <h2 class="H"><span id="rev-h"></span><br><em id="rev-em"></em></h2>
    </div>
    <div class="rv-scroll" id="reviews-scroll"></div>
  </div>
</section>

<!-- ═══ CTA ═══ -->
<section id="cta">
  <div class="cta-bg"></div><div class="cta-over"></div>
  <div class="cta-c">
    <div class="ey rv" style="justify-content:center;color:var(--gl)" id="cta-ey"></div>
    <h2 class="H rv" style="text-align:center"><span id="cta-h"></span><br><em id="cta-em"></em></h2>
    <p class="bod rv" style="text-align:center;margin:24px auto 0" id="cta-b"></p>
    <a href="https://www.book.persenk.eu/?lng=en-GB" target="_blank" class="cta-btn rv" id="cta-btn"></a>
  </div>
</section>

<!-- ═══ FOOTER ═══ -->
<footer>
  <div class="W">
    <div class="fg">
      <div>
        <div class="fl">PERSENK</div>
        <p class="fd" id="footer-desc"></p>
        <div class="fsoc">
          <a href="https://www.facebook.com/www.persenk.eu/" target="_blank" class="fsc">f</a>
          <a href="https://www.instagram.com/spahotelpersenk/" target="_blank" class="fsc">◎</a>
        </div>
      </div>
      <div><div class="fct" id="footer-nav-title"></div><ul class="fcl" id="footer-nav-list"></ul></div>
      <div><div class="fct" id="footer-offers-title"></div><ul class="fcl" id="footer-offers-list"></ul></div>
      <div><div class="fct" id="footer-contact-title"></div><ul class="fcl" id="footer-contact-list"></ul></div>
    </div>
    <div class="fbot">
      <div class="fcp" id="footer-copy"></div>
      <div class="faw" id="footer-awards"></div>
    </div>
  </div>
</footer>
</main>

<script>
/* ═══════════════════════════════════════════════════════════
   window.SITE_CONTENT — ALL TRANSLATIONS & ASSET URLs
   ═══════════════════════════════════════════════════════════ */
window.SITE_CONTENT = {{
  {ASSETS_JS},
  en: {EN_JS},
  bg: {BG_JS}
}};

{JS}
</script>
</body>
</html>"""

OUT = '/mnt/user-data/outputs/persenk-v2-final.html'
with open(OUT,'w',encoding='utf-8') as f:
    f.write(HTML)
size = os.path.getsize(OUT)
print(f"✓ Done: {size/1024/1024:.2f} MB → {OUT}")
