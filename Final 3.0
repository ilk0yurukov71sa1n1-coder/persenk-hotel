import base64, os, json, sys
sys.path.insert(0, '/home/claude')
from content import EN, BG

def b64(p):
    with open(p,'rb') as f:
        return "data:image/jpeg;base64,"+base64.b64encode(f.read()).decode()

U = '/mnt/user-data/uploads/'
IMGS = {k:b64(U+v) for k,v in {
    'hero':'IMG_5044.jpeg','entrance':'IMG_5173.jpeg','lobby':'IMG_5047.jpeg',
    'corridor':'IMG_5172.jpeg','room':'IMG_5043.jpeg','pool_main':'IMG_5042.jpeg',
    'jacuzzi':'IMG_5050.jpeg','mineral':'IMG_5049.jpeg','sauna':'IMG_5045.jpeg',
    'salt':'IMG_5052.jpeg','banquet':'IMG_5048.jpeg','terrace':'IMG_5051.jpeg',
    'nightbar':'IMG_5046.jpeg'
}.items()}

def jdump(obj):
    return json.dumps(obj, ensure_ascii=False)

# Build assets block
ASSETS_JS = "assets:{" + ",".join(f'{k}:"{v}"' for k,v in IMGS.items()) + "}"

def dict_to_js(d):
    parts = []
    for k, v in d.items():
        if isinstance(v, str):
            escaped = v.replace('\\','\\\\').replace('`','\\`').replace('${','\\${')
            parts.append(f'{k}:`{escaped}`')
        elif isinstance(v, list):
            parts.append(f'{k}:{jdump(v)}')
        elif isinstance(v, dict):
            parts.append(f'{k}:{jdump(v)}')
        elif isinstance(v, bool):
            parts.append(f'{k}:{"true" if v else "false"}')
        else:
            parts.append(f'{k}:{jdump(v)}')
    return "{" + ",".join(parts) + "}"

EN_JS  = dict_to_js(EN)
BG_JS  = dict_to_js(BG)

SPA_PANELS_HTML = ""
panel_imgs = [('jacuzzi','Jacuzzi'),('mineral','Mineral Pool'),('sauna','Sauna'),('salt','Salt Room')]
for i,(k,alt) in enumerate(panel_imgs):
    SPA_PANELS_HTML += f'''<div class="sg rv d{i+1}">
      <img src="{IMGS[k]}" alt="{alt}">
      <div class="sg-over"><div class="sg-tag"></div><div class="sg-name"></div><div class="sg-desc"></div></div>
    </div>\n'''

DINING_HTML = f'''
<div class="dm rv d1"><img src="{IMGS['banquet']}" alt="Banquet Hall"><div class="dm-over"><div class="dm-name"></div></div></div>
<div class="dm rv d2"><img src="{IMGS['corridor']}" alt="Lobby Bar"><div class="dm-over"><div class="dm-name"></div></div></div>
<div class="dm rv d3"><img src="{IMGS['terrace']}" alt="Rooftop"><div class="dm-over"><div class="dm-name"></div></div></div>
<div class="dm rv d4"><img src="{IMGS['nightbar']}" alt="Night Bar"><div class="dm-over"><div class="dm-name"></div></div></div>'''

CSS = """
:root{--g:#c4a35a;--gl:#dbbe80;--gd:rgba(196,163,90,.13);--k:#04040b;--k2:#080810;--w:#f2ebe0;--wm:rgba(242,235,224,.6);--wf:rgba(242,235,224,.28)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--k);color:var(--w);font-family:'Jost',sans-serif;font-weight:300;overflow-x:hidden;cursor:none}
#cur{position:fixed;width:9px;height:9px;background:var(--g);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:screen;transition:width .2s,height .2s}
#cur2{position:fixed;width:42px;height:42px;border:1px solid rgba(196,163,90,.55);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%)}
#stars{position:fixed;inset:0;z-index:0;pointer-events:none}
body::before{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.42;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.038'/%3E%3C/svg%3E")}
main{position:relative;z-index:2}

/* ── NAV ── */
nav{position:fixed;top:0;left:0;right:0;z-index:500;display:flex;align-items:center;justify-content:space-between;padding:28px 64px;transition:padding .6s cubic-bezier(.22,1,.36,1),background .6s,border-color .6s;border-bottom:1px solid transparent}
nav.solid{background:rgba(4,4,11,.94);backdrop-filter:blur(28px);padding:14px 64px;border-color:rgba(196,163,90,.1)}
.nlogo{font-family:'Cinzel',serif;font-size:15px;letter-spacing:6px;color:var(--g);text-decoration:none;transition:opacity .3s}
.nlogo:hover{opacity:.72}
.nl{display:flex;gap:32px;list-style:none}
.nl a{font-family:'Cinzel',serif;font-size:8.5px;letter-spacing:3.5px;text-decoration:none;color:rgba(242,235,224,.55);text-transform:uppercase;transition:color .3s}
.nl a:hover{color:var(--g)}
.nav-right{display:flex;align-items:center;gap:16px}
.nbtn{font-family:'Cinzel',serif;font-size:8.5px;letter-spacing:3px;text-decoration:none;color:var(--k);background:var(--g);padding:12px 28px;text-transform:uppercase;transition:all .35s cubic-bezier(.22,1,.36,1)}
.nbtn:hover{background:var(--gl);transform:translateY(-1px);box-shadow:0 10px 40px rgba(196,163,90,.28)}

/* ── FIXED BOTTOM-LEFT LANGUAGE SWITCHER ── */
#lang-bar{
  position:fixed;bottom:28px;left:28px;z-index:998;
  display:flex;align-items:center;gap:14px;
  background:rgba(4,4,11,.82);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border:1px solid rgba(196,163,90,.18);
  padding:10px 18px 10px 16px;
  border-radius:3px;
  box-shadow:0 8px 32px rgba(0,0,0,.45),inset 0 1px 0 rgba(196,163,90,.08);
  transition:opacity .3s,transform .3s;
}
#lang-bar:hover{opacity:1;box-shadow:0 12px 40px rgba(0,0,0,.55),inset 0 1px 0 rgba(196,163,90,.12)}
.lang-label-txt{
  font-family:'Jost',sans-serif;font-weight:200;
  font-size:9.5px;letter-spacing:1.2px;
  color:rgba(242,235,224,.35);
  white-space:nowrap;line-height:1;
  pointer-events:none;user-select:none;
}
.lang-sep{width:1px;height:14px;background:rgba(196,163,90,.2);flex-shrink:0}
.lang-btns{display:flex;align-items:center;gap:0;border:1px solid rgba(196,163,90,.22);border-radius:2px;overflow:hidden}
.lang-btn{
  font-family:'Cinzel',serif;font-size:8px;letter-spacing:2.5px;
  color:rgba(242,235,224,.38);text-transform:uppercase;
  padding:7px 13px;cursor:pointer;
  transition:background .28s,color .28s;
  user-select:none;border:none;background:transparent;
  line-height:1;
}
.lang-btn.active{background:var(--g);color:var(--k);font-weight:600}
.lang-btn:hover:not(.active){background:rgba(196,163,90,.1);color:rgba(196,163,90,.85)}

/* ── HERO ── */
#hero{height:100vh;position:relative;overflow:hidden;display:flex;align-items:flex-end}
.hbg{position:absolute;inset:0;filter:brightness(.45) saturate(.8);transform:scale(1.08);transition:transform 15s ease,filter 1.5s;background-position:center 62%;background-size:cover}
.hbg.ready{transform:scale(1)}
.hvig{position:absolute;inset:0;background:linear-gradient(to top,rgba(4,4,11,.97) 0%,rgba(4,4,11,.52) 32%,rgba(4,4,11,.12) 62%,rgba(4,4,11,.28) 100%)}
.hcontent{position:relative;z-index:3;padding:0 80px 88px;width:100%;display:flex;align-items:flex-end;justify-content:space-between}
.hleft{max-width:800px}
.heyebrow{font-family:'Cinzel',serif;font-size:9px;letter-spacing:8px;color:var(--g);text-transform:uppercase;display:flex;align-items:center;gap:18px;margin-bottom:22px;opacity:0;transform:translateX(-20px);animation:slix .9s .4s cubic-bezier(.22,1,.36,1) forwards}
.heyebrow::before{content:'';width:36px;height:1px;background:var(--g)}
.htitle{font-family:'Cormorant Garamond',serif;font-size:clamp(78px,11vw,154px);font-weight:300;line-height:.86;letter-spacing:-4px;opacity:0;transform:translateY(44px);animation:fupp 1.1s .6s cubic-bezier(.22,1,.36,1) forwards}
.htitle em{font-style:italic;color:var(--gl);display:block;font-size:.76em}
.hsub{margin-top:30px;font-weight:200;font-size:12px;letter-spacing:5px;color:var(--wm);text-transform:uppercase;opacity:0;animation:fupp .8s 1s cubic-bezier(.22,1,.36,1) forwards}
.hright{opacity:0;animation:fupp .7s 1.3s cubic-bezier(.22,1,.36,1) forwards;text-align:right}
.hstars{color:var(--g);font-size:18px;letter-spacing:7px}
.hstars-label{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--wf);text-transform:uppercase;margin-top:5px}
.hscroll{position:absolute;right:52px;top:50%;transform:translateY(-50%);z-index:3;display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:fupp .7s 1.7s forwards}
.hscroll-txt{font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;color:var(--wf);writing-mode:vertical-rl}
.hscroll-ln{width:1px;height:64px;background:linear-gradient(to bottom,var(--g),transparent);animation:scpulse 2.2s infinite}
@keyframes scpulse{0%,100%{opacity:.2}50%{opacity:1}}

/* ── TICKER ── */
.tk{overflow:hidden;padding:14px 0;border-top:1px solid rgba(196,163,90,.09);border-bottom:1px solid rgba(196,163,90,.09);background:rgba(4,4,11,.4)}
.tkt{display:flex;white-space:nowrap;animation:tickr 32s linear infinite}
.tkt span{font-family:'Cinzel',serif;font-size:8px;letter-spacing:6px;color:var(--g);text-transform:uppercase;padding:0 52px}
.tkt span::after{content:'◆';margin-left:52px;opacity:.35;font-size:6px}
@keyframes tickr{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── REVEAL ── */
.rv{opacity:0;transform:translateY(50px)}.rl{opacity:0;transform:translateX(-52px)}.rr{opacity:0;transform:translateX(52px)}
.rv,.rl,.rr{transition:opacity 1s cubic-bezier(.22,1,.36,1),transform 1s cubic-bezier(.22,1,.36,1)}
.rv.on,.rl.on,.rr.on{opacity:1;transform:none}
.d1{transition-delay:.06s!important}.d2{transition-delay:.15s!important}.d3{transition-delay:.25s!important}.d4{transition-delay:.36s!important}.d5{transition-delay:.48s!important}

/* ── SECTION ── */
section{padding:124px 0;position:relative}
.W{max-width:1300px;margin:0 auto;padding:0 68px}
.ey{font-family:'Cinzel',serif;font-size:8px;letter-spacing:5.5px;color:var(--g);text-transform:uppercase;display:flex;align-items:center;gap:14px;margin-bottom:18px}
