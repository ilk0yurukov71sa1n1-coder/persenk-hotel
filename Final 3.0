    <div class="dining-h">
      <div class="rl">
        <div class="ey" id="dining-ey"></div>
        <h2 class="H"><span id="dining-h"></span><br><em id="dining-em"></em></h2>
      </div>
      <div class="rr">
        <p class="bod" style="margin-bottom:28px" id="dining-b"></p>
        <a href="https://persenk.eu/en/about-us/restaurants-and-bars/" target="_blank" class="pill" id="dining-link"></a>
      </div>
    </div>
  </div>
  <div class="dining-mosaic rv">{DINING_HTML}</div>
  <div class="W">
    <div class="dine-num rv">
      <div class="dn">7</div>
      <div class="dn-text"><div class="dn-title" id="dn-title"></div><div class="dn-sub" id="dn-sub"></div></div>
    </div>
  </div>
</section>

<!-- ═══ ROOFTOP ═══ -->
<section id="rooftop" style="padding:0;position:relative;overflow:hidden;min-height:620px;display:flex;align-items:center">
