      <img src="{IMGS['pool_main']}" alt="Indoor Pool">
      <div class="spa-caption" id="spa-caption"></div>
    </div>
    <div class="spa-text rr">
      <div class="ey" id="spa-ey"></div>
      <h2 class="H" style="font-size:clamp(38px,4vw,62px)"><span id="spa-h"></span><br><em id="spa-em"></em></h2>
